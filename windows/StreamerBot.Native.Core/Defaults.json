    "hk_custom_1": "",
    "hk_custom_1_mode": "V+T",
    "hk_custom_1_short": false,
    "hk_custom_1_custom": "",
    "hk_custom_1_prompt": "React with pure hype to hitting a WWE-style suplex or brutal grapple on an enemy. Scream about how Kliff just broke that guy in half with the crazy physics!",
    "hk_custom_1_audio": "",
    "hk_custom_1_audio_enabled": false,
    "hk_custom_1_mute_ai": false,
    "hk_custom_2": "",
    "hk_custom_2_mode": "V+T",
    "hk_custom_2_short": false,
    "hk_custom_2_custom": "",
    "hk_custom_2_prompt": "Freak out because an enemy just used a crazy new attack, and Kliff just 'witnessed and learned' it mid-combat! Brag to the viewers that you're about to use it against them.",
    "hk_custom_2_audio": "",
    "hk_custom_2_audio_enabled": false,
    "hk_custom_2_mute_ai": false,
    "hk_custom_3": "",
    "hk_custom_3_mode": "V+T",
    "hk_custom_3_short": false,
    "hk_custom_3_custom": "",
    "hk_custom_3_prompt": "Lose your mind with excitement because you just unlocked and started piloting a dwarven mech or riding a dragon for the first time.",
    "hk_custom_3_audio": "",
    "hk_custom_3_audio_enabled": false,
    "hk_custom_3_mute_ai": false,
    "hk_custom_4": "",
    "hk_custom_4_mode": "V+T",
    "hk_custom_4_short": false,
    "hk_custom_4_custom": "",
    "hk_custom_4_prompt": "Get totally distracted from a serious mercenary mission because you found a cat to pet or a pig to carry around. Tell chat this is the real endgame.",
    "hk_custom_4_audio": "",
    "hk_custom_4_audio_enabled": false,
    "hk_custom_4_mute_ai": false,
    "hk_custom_5": "",
    "hk_custom_5_mode": "V+T",
    "hk_custom_5_short": false,
    "hk_custom_5_custom": "",
    "hk_custom_5_prompt": "Panic hilariously because you accidentally hit someone or stole a wagon in Hernand, and now the guards are hunting you. Beg chat for escape advice!",
    "hk_custom_5_audio": "",
    "hk_custom_5_audio_enabled": false,
    "hk_custom_5_mute_ai": false,
    "hk_custom_6": "",
    "hk_custom_6_mode": "V+T",
    "hk_custom_6_short": false,
    "hk_custom_6_custom": "",
    "hk_custom_6_prompt": "Pop off with hype because you just found a super rare Abyss Artifact. Talk about how insane the stat boost is going to be for your build.",
    "hk_custom_6_audio": "",
    "hk_custom_6_audio_enabled": false,
    "hk_custom_6_mute_ai": false,
    "hk_custom_7": "",
    "hk_custom_7_mode": "V+T",
    "hk_custom_7_short": false,
    "hk_custom_7_custom": "",
    "hk_custom_7_prompt": "Brag to the viewers about destroying a tough boss purely through raw combat skill and perfect parries, since there's no level scaling to carry you in this game.",
    "hk_custom_7_audio": "",
    "hk_custom_7_audio_enabled": false,
    "hk_custom_7_mute_ai": false,
    "hk_custom_8": "",
    "hk_custom_8_mode": "V+T",
    "hk_custom_8_short": false,
    "hk_custom_8_custom": "",
    "hk_custom_8_prompt": "Panic because you are climbing a massive cliff using the grappling hook, and your blue stamina bar is about to run out. Scream that you're going to fall!",
    "hk_custom_8_audio": "",
    "hk_custom_8_audio_enabled": false,
    "hk_custom_8_mute_ai": false,
    "hk_custom_9": "",
    "hk_custom_9_mode": "V+T",
    "hk_custom_9_short": false,
    "hk_custom_9_custom": "",
    "hk_custom_9_prompt": "Proudly show off your newly built Greymane mercenary camp to the stream. Flex about the furniture or the NPCs you've recruited.",
    "hk_custom_9_audio": "",
    "hk_custom_9_audio_enabled": false,
    "hk_custom_9_mute_ai": false,
    "hk_custom_10": "",
    "hk_custom_10_mode": "V+T",
    "hk_custom_10_short": false,
    "hk_custom_10_custom": "",
    "hk_custom_10_prompt": "Marvel at the crazy BlackSpace Engine physics. React to kicking an enemy so hard they flew into a horse or completely shattered a wooden watchtower.",
    "hk_custom_10_audio": "",
    "hk_custom_10_audio_enabled": false,
    "hk_custom_10_mute_ai": false,
    "hk_custom_11": "",
    "hk_custom_11_mode": "V+T",
    "hk_custom_11_short": false,
    "hk_custom_11_custom": "",
    "hk_custom_11_prompt": "Take a chill, cozy break. Tell the viewers you're just kicking back to do some cooking, fishing (without a rod!), and vibing in the open world of Pywel.",
    "hk_custom_11_audio": "",
    "hk_custom_11_audio_enabled": false,
    "hk_custom_11_mute_ai": false,
    "hk_custom_12": "",
    "hk_custom_12_mode": "V+T",
    "hk_custom_12_short": false,
    "hk_custom_12_custom": "",
    "hk_custom_12_prompt": "Scream 'PARRY GOD!' and hype up your own reflexes after hitting a flawless, perfectly-timed sword block against a huge enemy attack.",
    "hk_custom_12_audio": "",
    "hk_custom_12_audio_enabled": false,
    "hk_custom_12_mute_ai": false,
    "hk_custom_13": "",
    "hk_custom_13_mode": "V+T",
    "hk_custom_13_short": false,
    "hk_custom_13_custom": "",
    "hk_custom_13_prompt": "React to igniting your sword with fire or another elemental imbuement. Tell chat how incredibly cool the combat animations look right now.",
    "hk_custom_13_audio": "",
    "hk_custom_13_audio_enabled": false,
    "hk_custom_13_mute_ai": false,
    "hk_custom_14": "",
    "hk_custom_14_mode": "V+T",
    "hk_custom_14_short": false,
    "hk_custom_14_custom": "",
    "hk_custom_14_prompt": "Yell in shock because you just got ambushed and surrounded by a massive group of outlaws in the wild. Tell chat it's time to lock in and focus.",
    "hk_custom_14_audio": "",
    "hk_custom_14_audio_enabled": false,
    "hk_custom_14_mute_ai": false,
    "hk_custom_15": "",
    "hk_custom_15_mode": "V+T",
    "hk_custom_15_short": false,
    "hk_custom_15_custom": "",
    "hk_custom_15_prompt": "Stop moving for a second and just admire the insane graphics. Point out the dynamic weather, the mud physics, or how beautiful the world looks.",
